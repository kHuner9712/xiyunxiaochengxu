{
  "version": 1,
  "description": "Every registered miniprogram page must appear here so release checks can prove it has an explicit acceptance path.",
  "pages": [
    { "path": "pages/home/index", "authRequired": false },
    { "path": "pages/category/index", "authRequired": false },
    { "path": "pages/activity/index", "authRequired": false },
    { "path": "pages/cart/index", "authRequired": true },
    { "path": "pages/user/index", "authRequired": false },
    { "path": "pages/product/list", "authRequired": false },
    { "path": "pages/product/detail", "authRequired": false, "queryEnv": { "id": "WECHAT_E2E_PRODUCT_ID" }, "readySelector": ".product-name" },
    { "path": "pages/search/index", "authRequired": false },
    { "path": "pages/order/confirm", "authRequired": true, "queryEnv": { "productId": "WECHAT_E2E_PRODUCT_ID", "skuId": "WECHAT_E2E_SKU_ID", "quantity": "WECHAT_E2E_QUANTITY" } },
    { "path": "pages/order/pay-result", "authRequired": true, "queryEnv": { "orderId": "WECHAT_E2E_ORDER_ID" } },
    { "path": "pages/order/list", "authRequired": true },
    { "path": "pages/order/detail", "authRequired": true, "queryEnv": { "id": "WECHAT_E2E_ORDER_ID" }, "readySelector": ".status-text" },
    { "path": "pages/address/list", "authRequired": true },
    { "path": "pages/address/edit", "authRequired": true },
    { "path": "pages/coupon/center", "authRequired": false },
    { "path": "pages/coupon/my", "authRequired": true },
    { "path": "pages/member/index", "authRequired": true },
    { "path": "pages/points/index", "authRequired": true },
    { "path": "pages/baby/list", "authRequired": true },
    { "path": "pages/baby/edit", "authRequired": true },
    { "path": "pages/activity/detail", "authRequired": false, "queryEnv": { "id": "WECHAT_E2E_ACTIVITY_ID" }, "readySelector": ".activity-name" },
    { "path": "pages/activity/checkout", "authRequired": true, "queryEnv": { "activityId": "WECHAT_E2E_ACTIVITY_ID", "activityProductId": "WECHAT_E2E_ACTIVITY_PRODUCT_ID", "skuId": "WECHAT_E2E_SKU_ID" } },
    { "path": "pages/aftersale/apply", "authRequired": true, "queryEnv": { "orderId": "WECHAT_E2E_ORDER_ID", "orderItemId": "WECHAT_E2E_ORDER_ITEM_ID" } },
    { "path": "pages/aftersale/list", "authRequired": true },
    { "path": "pages/aftersale/detail", "authRequired": true, "queryEnv": { "id": "WECHAT_E2E_AFTERSALE_ID" }, "readySelector": ".status-text" },
    { "path": "pages/content/list", "authRequired": false },
    { "path": "pages/content/detail", "authRequired": false, "queryEnv": { "id": "WECHAT_E2E_CONTENT_ID" }, "readySelector": ".content-title" },
    { "path": "pages/user/profile", "authRequired": true },
    { "path": "pages/pickup-store/list", "authRequired": false },
    { "path": "pages/customer-service/index", "authRequired": false },
    { "path": "pages/share/invite", "authRequired": true },
    { "path": "pages/agreement/index", "authRequired": false },
    { "path": "pages/privacy/index", "authRequired": false },
    { "path": "pages/food-safety/index", "authRequired": false },
    { "path": "pages/activity-content/list", "authRequired": false },
    { "path": "pages/activity-content/detail", "authRequired": false, "queryEnv": { "id": "WECHAT_E2E_ACTIVITY_CONTENT_ID" }, "readySelector": ".detail-title" },
    { "path": "pages/benefit-package/list", "authRequired": false },
    { "path": "pages/benefit-package/detail", "authRequired": false, "queryEnv": { "id": "WECHAT_E2E_BENEFIT_PACKAGE_ID" }, "readySelector": ".hero-name" },
    { "path": "pages/benefit-package/my", "authRequired": true },
    { "path": "pages/benefit-package/entitlement", "authRequired": true, "queryEnv": { "id": "WECHAT_E2E_ENTITLEMENT_ID" }, "readySelector": ".code-value" },
    { "path": "pages/group-buy/list", "authRequired": false },
    { "path": "pages/group-buy/detail", "authRequired": false, "queryEnv": { "id": "WECHAT_E2E_GROUP_BUY_ACTIVITY_ID" }, "readySelector": ".name" },
    { "path": "pages/group-buy/group", "authRequired": false, "queryEnv": { "id": "WECHAT_E2E_GROUP_BUY_GROUP_ID" }, "readySelector": ".status-text" },
    { "path": "pages/group-buy/my", "authRequired": true },
    { "path": "pages/flash-sale/list", "authRequired": false },
    { "path": "pages/flash-sale/detail", "authRequired": false, "queryEnv": { "id": "WECHAT_E2E_FLASH_SALE_ACTIVITY_ID" }, "readySelector": ".name" },
    { "path": "pages/flash-sale/my", "authRequired": true }
  ],
  "realDeviceOnly": [
    "微信真实登录授权",
    "微信手机号授权",
    "微信支付成功/取消/失败",
    "支付回调与掉单恢复",
    "微信退款与退款回调",
    "微信客服会话",
    "分享卡片与邀请场景参数",
