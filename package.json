{
  "name": "baby-mall",
  "version": "1.0.0",
  "private": true,
  "description": "禧孕优选母婴用品商城小程序",
  "scripts": {
    "dev:api": "pnpm --filter @baby-mall/api dev",
    "dev:admin": "pnpm --filter @baby-mall/admin-web dev",
    "dev:mini": "pnpm --filter @baby-mall/miniprogram dev:mp-weixin",
    "build:api": "pnpm --filter @baby-mall/api build",
    "build:admin": "pnpm --filter @baby-mall/admin-web build",
    "build:mini": "pnpm --filter @baby-mall/miniprogram build:mp-weixin",
    "build:mini:prod": "cross-env NODE_ENV=production pnpm --filter @baby-mall/miniprogram build:mp-weixin",
    "build:all": "pnpm build:api && pnpm build:admin && pnpm build:mini",
    "build": "pnpm build:api && pnpm build:admin",
    "prepare:ci": "pnpm --filter @baby-mall/shared build && pnpm --filter @baby-mall/api prisma:generate",
    "typecheck": "pnpm prepare:ci && pnpm --filter @baby-mall/api build && pnpm --filter @baby-mall/admin-web typecheck && pnpm --filter @baby-mall/miniprogram typecheck",
    "lint": "pnpm --filter @baby-mall/api lint && pnpm --filter @baby-mall/admin-web lint",
    "test:admin": "node --test apps/admin-web/src/utils/pending-content-asset-cleanup.test.mjs apps/admin-web/src/core-operation-permissions.test.mjs apps/admin-web/src/batch-delivery-tracking.test.mjs apps/admin-web/src/aftersale-refund-retry.test.mjs apps/admin-web/src/reconcile-history-observability.test.mjs apps/admin-web/src/supplier-operation-contract.test.mjs apps/admin-web/src/business-role-access-contract.test.mjs apps/admin-web/src/recommendation-operation-contract.test.mjs",
    "test:admin:browser": "node deploy/scripts/run-admin-browser-e2e.mjs",
    "test:ci": "pnpm prepare:ci && pnpm test:admin && pnpm --filter @baby-mall/api test:ci && pnpm --filter @baby-mall/miniprogram test",
    "audit:runtime": "node deploy/scripts/audit-runtime-contracts.mjs",
    "audit:api-contracts": "node deploy/scripts/audit-api-contracts.mjs",
    "audit:project": "pnpm audit:runtime && pnpm audit:api-contracts",
    "clean": "pnpm -r clean",
    "docker:up": "cd deploy && docker compose up -d --build",
    "docker:down": "cd deploy && docker compose down",
    "deploy:prod": "bash deploy/scripts/deploy-production.sh",
    "smoke": "bash deploy/scripts/smoke-runtime.sh",
    "smoke:public": "cd deploy && bash scripts/smoke-public.sh",
    "smoke:login": "cd deploy && bash scripts/smoke-admin-login.sh",
    "smoke:runtime": "bash deploy/scripts/smoke-runtime.sh",
    "smoke:all": "bash deploy/scripts/smoke-runtime.sh",
    "validate:api": "pnpm --filter @baby-mall/api prisma:validate && pnpm --filter @baby-mall/api test:ci && pnpm build:api",
    "prisma:migrate:dry-run": "bash deploy/scripts/prisma-migrate-dry-run.sh",
    "uploads:migrate-visibility": "node deploy/scripts/migrate-upload-visibility.mjs",
    "release:check": "pnpm audit:project && node deploy/scripts/run-release-check.mjs",
    "release:check:freeze": "pnpm audit:project && node deploy/scripts/run-release-check.mjs --code-freeze-gate",
    "release:check:prod": "pnpm audit:project && cross-env NODE_ENV=production node deploy/scripts/run-release-check.mjs --require-real-wx-appid --strict-prod-gate"
  },
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.13.0 <25",
    "pnpm": ">=11.2.2 <12"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11"
  }
}
