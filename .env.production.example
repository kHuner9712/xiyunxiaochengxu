# ============================================
# 禧孕优选 生产环境模板（可提交）
# 复制为 .env.production 后填写真实值
# 严禁提交 .env.production
# ============================================

# ---------- 基础 ----------
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
# 后端所有外部 HTTP 调用（微信登录/支付/退款/关单、业务告警）的最大等待时间，毫秒。
# 防止上游网络半开或长时间无响应占满 API 连接；允许范围 1000-60000。
OUTBOUND_HTTP_TIMEOUT_MS=10000

# Docker 宿主机端口；MySQL、Redis、API 仅绑定 127.0.0.1
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6379
API_HOST_PORT=3001
HTTP_HOST_PORT=80
HTTPS_HOST_PORT=443

# 构建管理后台时由部署脚本或命令行注入当前 Git SHA
# BUILD_SHA=d0db511

# ---------- 数据库 ----------
DB_HOST=mysql
DB_PORT=3306
DB_NAME=baby_mall
DB_USER=root
DB_PASSWORD='REPLACE_WITH_STRONG_DB_PASSWORD'
# DATABASE_URL 必须显式填写。若数据库密码含 @ : / # % ? & 等 URI 保留字符，
# 必须先对用户名/密码部分做 percent-encoding，不能依赖 Docker Compose 从 DB_PASSWORD 拼接。
# 例如原密码 P@ss#2026 应写为 P%40ss%232026。
DATABASE_URL=mysql://root:REPLACE_WITH_PERCENT_ENCODED_DB_PASSWORD@mysql:3306/baby_mall

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD='REPLACE_WITH_STRONG_REDIS_PASSWORD'

# ---------- 鉴权 ----------
JWT_SECRET='REPLACE_WITH_STRONG_JWT_SECRET'
JWT_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=2h
REFRESH_TOKEN_SECRET='REPLACE_WITH_STRONG_REFRESH_TOKEN_SECRET'
REFRESH_TOKEN_EXPIRES_IN=30d

# ---------- 微信小程序 ----------
WECHAT_APP_ID=REPLACE_WITH_REAL_WX_APP_ID
WECHAT_APP_SECRET=REPLACE_WITH_REAL_WX_APP_SECRET

# ---------- 微信支付 V3 ----------
WECHAT_MCH_ID=REPLACE_WITH_REAL_MCH_ID
WECHAT_MCH_SERIAL_NO=REPLACE_WITH_REAL_MCH_SERIAL_NO
WECHAT_API_V3_KEY=REPLACE_WITH_REAL_API_V3_KEY
WECHAT_PRIVATE_KEY_PATH=/app/apps/api/certs/apiclient_key.pem
WECHAT_PLATFORM_CERT_PATH=/app/apps/api/certs/wechatpay_platform.pem
WECHAT_PLATFORM_CERT_SERIAL_NO=REPLACE_WITH_REAL_PLATFORM_CERT_SERIAL_NO
# 可选：平台证书轮换期间同时信任多个序列号。JSON 的文件路径必须是 API 容器内路径，
# 对应 PEM 文件放在 deploy/certs/，该目录会只读挂载到 /app/apps/api/certs。
# WECHAT_PLATFORM_CERT_MAP='{"SERIAL_OLD":"/app/apps/api/certs/wechatpay_platform_old.pem","SERIAL_NEW":"/app/apps/api/certs/wechatpay_platform.pem"}'
WECHAT_NOTIFY_URL=https://api.yunxixiaochengxu.com.cn/api/weapp/pay/callback
WECHAT_REFUND_NOTIFY_URL=https://api.yunxixiaochengxu.com.cn/api/weapp/pay/refund-callback
WECHAT_SKIP_VERIFY=false

# ---------- 管理后台 ----------
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD='REPLACE_WITH_STRONG_ADMIN_PASSWORD'
SMOKE_TEST_BYPASS_CAPTCHA=false

# ---------- 跨域 ----------
CORS_ORIGINS=https://admin.yunxixiaochengxu.com.cn

# ---------- 关键业务告警 ----------
# 可选：critical 级业务事件外部告警地址；为空时 critical 事件仍写入数据库和日志，但不会外发。
# ALERT_WEBHOOK_URL=https://your-wecom-or-dingtalk-or-feishu-gateway.example.com/alert

# ---------- 上传 ----------
UPLOAD_DIR=/app/apps/api/uploads
# API 最大 50MB；Nginx 请求体上限为 60MB，用于容纳 multipart 额外开销
UPLOAD_MAX_SIZE=52428800
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4
UPLOAD_PUBLIC_URL=https://api.yunxixiaochengxu.com.cn
# 公开文件路径为 /uploads/public/...；私有文件仅允许通过后端鉴权接口访问

# ---------- 业务参数 ----------
# 订单自动关单/自动收货、售后期限、默认运费/包邮门槛、积分抵扣等可变业务参数
# 统一由数据库 system_configs 与管理后台“系统配置”控制；生产环境变量不是这些参数的配置入口。
# 偏远地区名单和附加运费目前是代码版本化常量，变更必须通过代码审查和发布流程。

# ---------- 证书宿主机目录约定 ----------
# 微信支付证书：
#   deploy/certs/apiclient_key.pem
#   deploy/certs/wechatpay_platform.pem
#   deploy/certs/wechatpay_platform_*.pem（可选，平台证书轮换）
# Nginx API 域名证书：
#   deploy/nginx/ssl/api/fullchain.pem
#   deploy/nginx/ssl/api/privkey.pem
# Nginx 管理后台域名证书：
#   deploy/nginx/ssl/admin/fullchain.pem
#   deploy/nginx/ssl/admin/privkey.pem

# ---------- 说明 ----------
# 1. WECHAT_PRIVATE_KEY_PATH / WECHAT_PLATFORM_CERT_PATH 是 API 容器内路径。
# 2. 密码和密钥建议至少16位，并包含大小写字母、数字和特殊字符。
# 3. JWT_SECRET 与 REFRESH_TOKEN_SECRET 生产环境至少32字符。
# 4. Docker Compose 会对未引用或双引号中的 $ 做变量插值；秘密值含 $ 时优先使用单引号，或按 Compose 规则写成 $$。DATABASE_URL 仍必须按 URI 规则 percent-encode。
# 5. 正式部署脚本还要求从 main 分支部署，并通过 EXPECTED_DEPLOY_SHA 明确指定要发布的完整 40 位提交 SHA。